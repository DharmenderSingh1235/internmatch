# Choose one provider: openai, gemini, or anthropic
AI_PROVIDER=openai

# Add the key for the selected provider. Keep real keys in server/.env only.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# For Google Gemini instead, set AI_PROVIDER=gemini and fill this key:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
# Used only if the primary Gemini model is temporarily overloaded.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# For Anthropic Claude instead, set AI_PROVIDER=anthropic and fill this key:
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional server settings
PORT=3002
# Add one or more exact frontend origins, comma-separated (no trailing slash).
ALLOWED_ORIGIN=
# Set true only when the API is behind exactly one trusted reverse proxy.
TRUST_PROXY=false

# Set a strong private password for the admin API before starting the server.
ADMIN_PASSWORD=change-this-admin-password

# Optional managed MongoDB storage. If set, the first run imports existing
# server/data/portal-data.json records into MongoDB; after that MongoDB is primary.
# Replace every placeholder and keep this connection string only in server/.env.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/internmatch?retryWrites=true&w=majority
MONGODB_DB=internmatch
MONGODB_MAX_POOL_SIZE=20
