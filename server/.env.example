# Choose one provider: openai, gemini, or anthropic
AI_PROVIDER=openai

# Add the key for the selected provider. Keep real keys in server/.env only.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# For Google Gemini instead, set AI_PROVIDER=gemini and fill this key:
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# For Anthropic Claude instead, set AI_PROVIDER=anthropic and fill this key:
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional server settings
PORT=3001
ALLOWED_ORIGIN=

# Set a strong private password for the admin API before starting the server.
ADMIN_PASSWORD=change-this-admin-password

# Cloud migration settings (kept on the API server only; not active until the
# Supabase integration is enabled). Never expose the service role key in browser JS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
